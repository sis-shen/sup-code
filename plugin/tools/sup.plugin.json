{
  "name": "plugin-tools",
  "version": "2.0.0",
  "description": "Builtin tool registry (bash/read_file/write_file/edit_file/glob/grep) with tool pipeline event bridging.",
  "inject": ["permission"],
  "provides": ["tools"],
  "events": [
    { "name": "tools/pre-execute", "mode": "waterfall" },
    { "name": "tools/execute", "mode": "waterfall" },
    { "name": "tools/post-execute", "mode": "waterfall" },
    { "name": "tools/result", "mode": "emit" }
  ],
  "entry": "builtin:tools"
}
