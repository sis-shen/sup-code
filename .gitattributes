# Enforce LF for scripts and CI so they run correctly on Linux runners.
*.sh text eol=lf
*.bash text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf

# Go / Markdown / JSON defaults (force LF so gofmt is stable across platforms)
*.go text eol=lf
*.md text eol=lf
*.json text eol=lf

# Binary-ish artifacts
*.exe binary
*.so binary
